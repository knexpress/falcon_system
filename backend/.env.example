# Required — Postgres connection string from Neon / Supabase / Render / Railway
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required — frontend URL allowed to call this API (no trailing slash)
# Production example: https://your-app.vercel.app
# Local + production: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional — set to false only for local Postgres without SSL
# DATABASE_SSL=false

# Optional — Render sets PORT automatically
# PORT=4000
