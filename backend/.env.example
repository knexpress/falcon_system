# Local Docker Postgres
# From repo root: docker compose up -d
DATABASE_URL=postgresql://falcon:falcon@127.0.0.1:5432/falcon
DATABASE_SSL=false

# Or Neon / hosted Postgres
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# DATABASE_SSL=true

# Comma-separated frontend URLs, or * to allow all browser origins
CORS_ORIGIN=*

# Optional Firebase Cloud Messaging (remote push to phones)
# FIREBASE_SERVICE_ACCOUNT=C:\path\to\serviceAccount.json
# Or inline JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional Object Storage
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
